# Все переменные необязательны: DataArena полностью работает без единой из них.
#
# Перечислены только те, которые код действительно читает. Настройки под будущие этапы
# сюда не добавляются: описанная, но не читаемая переменная выглядит работающей
# и молча ни на что не влияет.

# Где хранятся workspace: манифесты, исходные файлы, нормализованные артефакты, состояние
DATAARENA_WORKSPACE_ROOT=~/.dataarena/workspaces

# Предел размера одного загружаемого файла, МБ
DATAARENA_MAX_UPLOAD_MB=512

# Адрес frontend для CORS
DATAARENA_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Адрес ModelArena. Если не задан, кнопка «Open in ModelArena» сообщает,
# что сервис не настроен. Ничего больше при этом не ломается.
DATAARENA_MODELARENA_URL=
