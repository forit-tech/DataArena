{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forit.tech/schemas/dataarena/package/v1/lineage.schema.json",
  "title": "Dataset Package lineage.json (dataarena.package/1)",
  "description": "Линейная история происхождения одного результата. Не Git для датасетов: ветвлений, слияний версий и diff-ов нет.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format_version", "created_at", "sources", "graph"],
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "package_id": { "type": "string", "maxLength": 100 },
    "created_at": { "$ref": "#/$defs/timestamp" },

    "sources": {
      "type": "array",
      "description": "Исходные файлы с хешами. Позволяют понять, на каких данных получен результат.",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "format", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/node_id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "format": { "type": "string", "maxLength": 50 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "row_count": { "type": "integer", "minimum": 0 },
          "column_count": { "type": "integer", "minimum": 0 },
          "read_options": { "type": "object", "additionalProperties": true }
        }
      }
    },

    "graph": {
      "type": "array",
      "description": "Узлы преобразований в порядке выполнения. inputs ссылаются на id узлов или источников.",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "op", "inputs"],
        "properties": {
          "id": { "$ref": "#/$defs/node_id" },
          "op": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Незнакомую операцию потребитель показывает как есть.",
            "examples": ["read", "rename_column", "cast_column", "drop_columns", "filter_rows", "join", "deduplicate", "select_columns"]
          },
          "inputs": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/$defs/node_id" }
          },
          "source": { "$ref": "#/$defs/node_id" },
          "output_rows": { "type": "integer", "minimum": 0 },
          "params": { "type": "object", "additionalProperties": true },
          "note": { "type": "string", "maxLength": 1000 }
        }
      }
    },

    "row_count_trace": {
      "type": "array",
      "description": "Как менялось число строк по шагам. Отвечает на вопрос, на каком шаге строк стало больше или меньше.",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["after", "rows"],
        "properties": {
          "after": { "$ref": "#/$defs/node_id" },
          "rows": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "provenance": {
      "type": "object",
      "description": "С 1.1.0, необязательно. Известно ли, как создан датасет, и полна ли его история. Отсутствие поля — «producer не сообщил», а не «история полна».",
      "additionalProperties": true,
      "required": ["status", "history"],
      "properties": {
        "status": { "type": "string", "maxLength": 50, "description": "known | unknown. Незнакомое значение потребитель понимает как unknown." },
        "origin": { "type": ["string", "null"], "maxLength": 50, "description": "upload | join | null, если неизвестно." },
        "unknown_reason": { "type": ["string", "null"], "maxLength": 100 },
        "history": { "type": "string", "maxLength": 50, "description": "complete | incomplete. Незнакомое значение потребитель понимает как incomplete." },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "maxLength": 100 }
        }
      }
    },

    "columns": {
      "type": "array",
      "description": "С 1.1.0, необязательно. История каждой колонки результата в порядке schema.json. Отсутствие поля — история колонок не передана.",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "origin", "origins", "events"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "origin": { "type": "string", "maxLength": 50, "description": "source | step | unknown." },
          "history": { "type": "string", "maxLength": 50, "description": "complete | incomplete; отсутствие — complete." },
          "origins": {
            "type": "array",
            "description": "Колонки-источники, 0..N. Пусто тогда и только тогда, когда origin = unknown.",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["column"],
              "properties": {
                "column": { "$ref": "#/$defs/text" },
                "dataset_id": { "type": ["string", "null"], "maxLength": 100 },
                "dataset_name": { "type": ["string", "null"], "maxLength": 300 },
                "source_file": { "type": ["string", "null"], "maxLength": 300 },
                "source_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
                "source": { "$ref": "#/$defs/node_id" }
              }
            }
          },
          "events": {
            "type": "array",
            "description": "События в хронологическом порядке: шаги родителей до сборки, соединение, шаги самого датасета. Порядок нормативен.",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["kind", "operation", "output"],
              "properties": {
                "kind": { "type": "string", "maxLength": 50, "description": "step | join." },
                "operation": { "type": "string", "minLength": 1, "maxLength": 100 },
                "dataset_id": { "type": ["string", "null"], "maxLength": 100 },
                "dataset_name": { "type": ["string", "null"], "maxLength": 300 },
                "position": { "type": "integer", "minimum": 0 },
                "step_id": { "type": ["string", "null"], "maxLength": 100 },
                "description": { "$ref": "#/$defs/text" },
                "inputs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
                "output": { "$ref": "#/$defs/text" },
                "node": { "$ref": "#/$defs/node_id" }
              }
            }
          },
          "read_by": {
            "type": "array",
            "description": "Узлы graph, которые колонку только читали, не меняя значений.",
            "maxItems": 10000,
            "items": { "$ref": "#/$defs/node_id" }
          }
        }
      }
    }
  },

  "$defs": {
    "text": { "type": "string", "maxLength": 10000 },
    "node_id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_.-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
